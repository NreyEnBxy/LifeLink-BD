rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Basic Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Validation
    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'name', 'bloodGroup', 'phoneNumber', 'isDonor'])
        && data.userId == request.auth.uid
        && data.name is string && data.name.size() <= 100
        && data.bloodGroup in ['A+', 'A-', 'B+', 'B-', 'O+', 'O-', 'AB+', 'AB-']
        && data.phoneNumber is string && data.phoneNumber.size() <= 20
        && data.isDonor is bool;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isSignedIn() && isOwner(userId) 
                    && isValidUser(request.resource.data)
                    && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'bloodGroup', 'phoneNumber', 'isDonor', 'isAvailable', 'lastDonationDate', 'location', 'updatedAt']));
    }

    // Emergency Request Validation
    function isValidRequest(data) {
      return data.keys().hasAll(['requesterId', 'bloodGroup', 'location', 'contactNumber', 'urgency', 'status', 'createdAt'])
        && data.requesterId == request.auth.uid
        && data.bloodGroup in ['A+', 'A-', 'B+', 'B-', 'O+', 'O-', 'AB+', 'AB-']
        && data.contactNumber is string && data.contactNumber.size() <= 20
        && data.urgency in ['Low', 'Normal', 'Critical']
        && data.status in ['Active', 'Fulfilled', 'Cancelled']
        && data.location.latitude is number && data.location.longitude is number;
    }

    match /emergency_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidRequest(request.resource.data);
      allow update: if isSignedIn() && resource.data.requesterId == request.auth.uid
                    && isValidRequest(request.resource.data)
                    && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'location', 'contactNumber', 'urgency']));
      allow delete: if isSignedIn() && (resource.data.requesterId == request.auth.uid || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    
    // Admin check helper (admins collection would need to be populated manually or via cloud console)
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    match /admins/{adminId} {
      allow read: if isSignedIn() && isOwner(adminId);
    }
  }
}
